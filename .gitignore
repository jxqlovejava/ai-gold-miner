# Environment
.env
.venv/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code local config
.claude/
.mcp.json

# CodeGraph index
.codegraph/

# Private data directory (contains real personal data)
data/private/
data/private/*

# JSONL data files (personal predictions, events, scenarios)
data/*.jsonl
# 事件日历是公开数据，允许提交
!data/calendar_events.jsonl
# 条件单示例文件是公开的字段定义，允许提交
!data/conditional_orders.example.jsonl

# Reports (generated, may contain personal data)
data/reports/

# Runtime cache (cross-process caches, e.g. DXY disk cache)
data/cache/

# Runtime logs (regenerated every run, no longer tracked)
logs/

# Proxy / network tools (contains credentials and binaries)
data/proxy/provider.yaml
data/proxy/config.yaml
data/proxy/cache.db
data/proxy/*.db
data/proxy/*.metadb
src/gold_miner/proxy/mihomo
docs/superpowers/specs/
data/output/.scan_log_*.log
data/output/*.stale
